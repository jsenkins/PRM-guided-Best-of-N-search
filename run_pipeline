n\nJudgeFn = Callable[[str], dict]\n# judge_fn(judge_prompt) -> {\"text\": str, \"num_tokens\": int}\n\n\ndef build_prm_judge_prompt(question: str, preceding_steps: list[str], current_step: str) -> str:\n    \n    \"\"\"\n    Builds the verification prompt for the PRM judge to classify current_step\n    as VALID or INVALID given the problem question and preceding_steps.\n    \n    Judge Semantics (Local Validity):\n    The judge evaluates current_step ASSUMING ALL PRECEDING STEPS ARE CORRECT.\n    A step is VALID if its arithmetic is sound and it follows logically from the\n    problem statement plus preceding steps as written. An error in an earlier step\n    does NOT make subsequent steps invalid by itself.\n    \n    Autograder Literal Checks:\n    - Preceding steps are rendered as 'Step 1: <text>', 'Step 2: <text>', ... in order.\n    - The current step is rendered with the label 'Current Step:'.\n    - The prompt contains the phrase 'assume all preceding steps are correct' (case-insensitive).\n    - The prompt contains the literal strings 'Verdict: VALID', 'Verdict: INVALID', and 'Rationale:'.\n    - With an empty preceding_steps list, the prompt states '(no preceding steps)'.\n    \"\"\"\n    # TODO: Build verification prompt instructing 7B judge under local validity\n   \n    \n    if preceding_steps:\n        preceding = \"\\n\".join(f\"Step {i}: {s}\" for i, s in enumerate(preceding_steps, start=1))\n    else:\n        preceding = \"(no preceding steps)\"\n\n\n    judge_prompt = (\n        f\"For the problem {question}, classify whether the current step {current_step} is valid or invalid given the preceeding steps {preceding_steps}\\n\"\n        \n        \"Do not deviate from the following instructions: \\n\"\n        \"Check the arithmetic and logical validity of each step. A VALID current step has sound arithmetic and it follows logically from the problem statement plus preceding steps as written so\\n\"\n        \"Validity depends on the current_step only. \\n\"\n        \"Preceeding INVALID step does not make current step INVALID. \\n\"\n        \"Preceding steps are rendered as 'Step 1: <text>', 'Step 2: <text>', ... in order.\\n\"\n        \"The current step is rendered with the label 'Current Step:'.\\n\"\n        \"Evaluate the Current Step. Assume all preceding steps are correct. \\n\"\n        \"With an empty preceding_steps list, the prompt states '(no preceding steps)'.\\n\"\n        f\"Problem:\\n{question}\\n\\n\"\n        f\"Preceding steps:\\n{preceding}\\n\\n\"\n        f\"Current Step:\\n{current_step}\\n\\n\"\n       \n        \n        \"Give the answer in the following format if it is VALID: \\n\"\n        \"Verdict: VALID \\n\"\n        \"Rationale: briefly state why it is valid. \\n\"\n\n        \"Give the answer in the following format if it is INVALID: \\n\"\n        \"Verdict: INVALID \\n\"\n        \"Rationale: briefly state why it is invalid. \\n\"\n\n                \n    )\n    return judge_prompt\n\n\n\ndef parse_judge_decision(judge_output: str) -> tuple[float, str]:\n    r\"\"\"\n    Parses the judge model's raw text completion into (score, rationale).\n    \n    Rules:\n      1. If a line matches /verdict\\s*:\\s*\\**\\s*(VALID|INVALID)\\b/i, use it.\n         If several exist, use the first.\n      2. Otherwise, if standalone word INVALID or phrase 'NOT VALID' appears\n         (case-insensitive, word boundaries) -> -1.0.\n      3. Otherwise, if standalone word VALID appears -> +1.0.\n      4. Otherwise -> -1.0 (unparseable defaults to INVALID).\n      \n    Warning: A naive '\"VALID\" in text' check is wrong because \"INVALID\" contains \"VALID\".\n    Rationale: Text after 'Rationale:' up to the first sentence end (\".\", \"!\", or \"?\"\n    followed by whitespace or end of string, so decimals like \"2.5\" are not split),\n    or a newline, whichever comes first, stripped. If absent, returns empty string \"\".\n    \"\"\"\n    # TODO: Implement regex parsing for judge verdict and rationale\n    VERDICT_RE   = r\"verdict\\s*:\\s*\\**\\s*(VALID|INVALID)\\b\"   # re.IGNORECASE, re.search (first match wins)\n    INVALID_RE   = r\"\\b(?:INVALID|NOT\\s+VALID)\\b\"             # re.IGNORECASE\n    VALID_RE     = r\"\\bVALID\\b\"                               # re.IGNORECASE\n    RATIONALE_RE = r\"rationale\\s*:[ \\t]*(.*?(?:[.!?](?=\\s|$)|(?=\\n)|$))\"\n    try:\n            \n        if not isinstance(judge_output, str):\n            return -1.0, \"\"\n        text = judge_output\n    \n        rm = re.search(RATIONALE_RE, text, flags=re.IGNORECASE)\n        rationale = rm.group(1).strip() if rm else \"\"\n    \n        vm = re.search(VERDICT_RE, text, flags=re.IGNORECASE)      \n        if vm:\n            return (1.0 if vm.group(1).upper() == \"VALID\" else -1.0), rationale\n        if re.search(INVALID_RE, text, flags=re.IGNORECASE):       \n            return -1.0, rationale\n        if re.search(VALID_RE, text, flags=re.IGNORECASE):         \n            return 1.0, rationale\n        return -1.0, rationale       \n    except Exception:\n        return -1.0, \"\"\n        \n\n\n        \n        \n\n\n\n\ndef score_path(\n    judge_model: Any = None, \n    judge_tokenizer: Any = None, \n    question: str = \"\", \n    candidate: dict[str, Any] | None = None, \n    judge_fn: JudgeFn | None = None\n) -> dict[str, Any]:\n    \"\"\"\n    Sequentially scores each step in candidate[\"steps\"] using judge_fn.\n    Step t is judged with preceding_steps = steps[:t].\n    \n    The student's code MUST call build_prm_judge_prompt to build the string passed to judge_fn,\n    and MUST call parse_judge_decision on the returned text.\n    \n    Returns:\n      step_scores, rationales, judge_calls, judge_tokens\n    \"\"\"\n    # TODO: Implement sequential step scoring under local validity\n    \n    if judge_fn is None:\n        judge_fn = make_hf_judge_fn(judge_model, judge_tokenizer)\n\n    steps = list((candidate or {}).get(\"steps\", []))\n    step_scores, rationales = [], []\n    judge_tokens = 0\n\n    for t, step in enumerate(steps):\n        prompt = build_prm_judge_prompt(question, steps[:t], step)\n        out = judge_fn(prompt)\n        score, rationale = parse_judge_decision(out.get(\"text\", \"\"))\n        step_scores.append(score)\n        rationales.append(rationale)\n        judge_tokens += int(out.get(\"num_tokens\", 0))\n\n    return {\n        \"step_scores\": step_scores,\n        \"rationales\": rationales,\n        \"judge_calls\": len(steps),\n        \"judge_tokens\": judge_tokens,\n    }","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-10T17:54:20.446576Z","iopub.execute_input":"2026-11-10T17:54:20.447037Z","iopub.status.idle":"2026-11-10T17:54:20.455866Z","shell.execute_reply.started":"2026-11-10T17:54:20.447006Z","shell.execute_reply":"2026-11-10T17:54:20.454991Z"}},"outputs":[{"name":"stdout","text":"Overwriting /kaggle/working/repo/src/prm_judge.py\n","output_type":"stream"}],"execution_count":16},{"cell_type":"code","source":"%%writefile /kaggle/working/repo/src/search.py\n\"\"\"\nsrc/search.py - Path aggregation, Best-of-N search, and compute-matched search.\n\"\"\"\nfrom typing import Any, Callable\n\nimport time\n\n\nfrom .generation import compute_majority_vote, run_self_consistency\nfrom .prm_judge import score_path\n\nGenerateFn = Callable[[str, int, dict], list[dict]]\nJudgeFn = Callable[[str], dict]\n\n\ndef aggregate_path_score(\n    step_scores: list[float], \n    strategy: str = \"min\", \n    penalty_lambda: float = 2.0\n) -> float:\n    \"\"\"\n    Aggregates a list of step scores (+1.0 or -1.0) into a scalar trajectory score.\n    \n    Rules:\n      - An empty list returns -1.0 for every strategy.\n      - 'min': min(step_scores).\n      - 'product': p_t = clamp((r_t + 1)/2, 0.01, 0.99); returns the raw product.\n      - 'step_penalty': mean(step_scores) - penalty_lambda * count(r_t == -1.0).\n      - An unknown strategy raises ValueError.\n    \"\"\"\n    # TODO: Implement min, product, and step_penalty aggregation\n\n    \n    if strategy not in (\"min\", \"product\", \"step_penalty\"):\n        raise ValueError(f\"Unknown aggregation strategy: {strategy}\")\n    if not step_scores:\n        return -1.0\n    if strategy == \"min\":\n        return float(min(step_scores))\n    if strategy == \"product\":\n        prod = 1.0\n        for r in step_scores:\n            prod *= min(max((r + 1.0) / 2.0, 0.01), 0.99)\n        return prod\n    n_bad = sum(1 for r in step_scores if r == -1.0)\n    return sum(step_scores) / len(step_scores) - penalty_lambda * n_bad\n\n\n\ndef select_best_path(\n    candidate_paths: list[dict[str, Any]], \n    aggregation_strategy: str = \"min\", \n    penalty_lambda: float = 2.0\n) -> dict[str, Any]:\n    \"\"\"\n    Selects the winning candidate path from candidate_paths.\n    \n    Input Dictionary Contract:\n      Each candidate dictionary in candidate_paths must contain 'step_scores' (list[float])\n      and 'answer' (int | None). Any other keys present in the candidate dictionary\n      are passed through unchanged in the returned copy.\n    \n    Selection & Tie-Breaking Rules:\n      1. Compute path_score for each candidate with aggregate_path_score.\n         A candidate with an empty step_scores list gets -1.0.\n      2. Eligibility: if at least one candidate has a non-None answer, candidates\n         with answer=None are excluded. If all answers are None, all remain eligible.\n      3. Find maximum path_score among eligible candidates (tolerance 1e-9).\n         The tied set is all eligible candidates within tolerance of the maximum.\n      4. If the tied set has more than one candidate, compute compute_majority_vote\n         over their answers. Return the lowest-index candidate in the tied set whose\n         answer equals the vote. If the vote is None, return the lowest-index tied candidate.\n      5. Returns a shallow COPY of the chosen dict with two added keys:\n         'path_score' (float) and 'num_tied' (int, size of the tied set).\n         Does not mutate the inputs.\n    \"\"\"\n    # TODO: Implement best path selection with answer=None filtering and majority tie-breaking\n\n    if not candidate_paths:\n        raise ValueError(\"candidate_paths must be non-empty\")\n\n    scores = [\n        aggregate_path_score(c.get(\"step_scores\", []), aggregation_strategy, penalty_lambda)\n        for c in candidate_paths\n    ]\n    eligible = list(range(len(candidate_paths)))\n    if any(c.get(\"answer\") is not None for c in candidate_paths):\n        eligible = [i for i in eligible if candidate_paths[i].get(\"answer\") is not None]\n\n    best = max(scores[i] for i in eligible)\n    tied = [i for i in eligible if abs(scores[i] - best) <= 1e-9]\n\n    chosen = tied[0]\n    if len(tied) > 1:\n        vote = compute_majority_vote([candidate_paths[i].get(\"answer\") for i in tied])\n        if vote is not None:\n            chosen = next(i for i in tied if candidate_paths[i].get(\"answer\") == vote)\n\n    out = dict(candidate_paths[chosen])\n    out[\"path_score\"] = float(scores[chosen])\n    out[\"num_tied\"] = len(tied)\n    return out\n\n\ndef run_prm_best_of_n(\n    model: Any = None, \n    judge_model: Any = None, \n    gen_tokenizer: Any = None, \n    judge_tokenizer: Any = None, \n    question: str = \"\", \n    n: int = 5, \n    aggregation_strategy: str = \"min\", \n    penalty_lambda: float = 2.0, \n    candidates: list[dict[str, Any]] | None = None, \n    generate_fn: GenerateFn | None = None, \n    judge_fn: JudgeFn | None = None\n) -> dict[str, Any]:\n    \"\"\"\n    Executes PRM-guided Best-of-N search over reasoning trajectories.\n    \n    If candidates is provided (shared candidate pool), does NOT sample new candidates\n    (generation_calls = 0, generated_tokens = 0). Provided candidates use the\n    run_self_consistency candidate format (at minimum 'steps' and 'answer').\n    Otherwise, samples n candidates using run_self_consistency.\n    \n    Scores each candidate's steps using score_path.\n    Selects the winning candidate via select_best_path.\n    \n    Returns:\n      selected, answer, candidates [each augmented with step_scores, rationales],\n      generation_calls, judge_calls, generated_tokens, judge_tokens, time_seconds\n    \"\"\"\n    # TODO: Implement PRM Best-of-N search over candidate trajectories\n    t0 = time.perf_counter()\n    generation_calls, generated_tokens = 0, 0\n\n    if candidates is None:\n        sc = run_self_consistency(model=model, tokenizer=gen_tokenizer, question=question,\n                                  n=n, generate_fn=generate_fn)\n        cands = [dict(c) for c in sc[\"candidates\"]]\n        generation_calls = sc[\"generation_calls\"]\n        generated_tokens = sc[\"generated_tokens\"]\n    else:\n        cands = [dict(c) for c in candidates]   \n\n    judge_calls, judge_tokens = 0, 0\n    for c in cands:\n        r = score_path(judge_model, judge_tokenizer, question, c, judge_fn=judge_fn)\n        c[\"step_scores\"] = r[\"step_scores\"]\n        c[\"rationales\"] = r[\"rationales\"]\n        judge_calls += r[\"judge_calls\"]\n        judge_tokens += r[\"judge_tokens\"]\n\n    selected = select_best_path(cands, aggregation_strategy, penalty_lambda)\n    return {\n        \"selected\": selected,\n        \"answer\": selected.get(\"answer\"),\n        \"candidates\": cands,\n        \"generation_calls\": generation_calls,\n        \"judge_calls\": judge_calls,\n        \"generated_tokens\": generated_tokens,\n        \"judge_tokens\": judge_tokens,\n        \"time_seconds\": time.perf_counter() - t0,\n    }\n\n\ndef run_compute_matched_self_consistency(\n    model: Any = None, \n    tokenizer: Any = None, \n    question: str = \"\", \n    target_calls: int = 15, \n    temperature: float = 0.7, \n    existing_candidates: list[dict[str, Any]] | None = None, \n    generate_fn: GenerateFn | None = None\n) -> dict[str, Any]:\n    \n    \"\"\"\n    Executes compute-matched Self-Consistency aggregating target_calls paths.\n    If existing_candidates are supplied, samples only the deficit:\n    target_calls - len(existing_candidates). Returned candidates = existing_candidates followed by new samples, in sampling order.\n    \n    Returns:\n      candidates, answer, generation_calls (new samples only), total_samples,\n      generated_tokens (new samples only), time_seconds\n    \"\"\"\n    # TODO: Implement compute-matched Self-Consistency with sample reuse\n    t0 = time.perf_counter()\n    existing = [dict(c) for c in (existing_candidates or [])]\n    deficit = max(0, target_calls - len(existing))\n\n    new_cands, new_tokens = [], 0\n    if deficit > 0:\n        sc = run_self_consistency(model=model, tokenizer=tokenizer, question=question,\n                                  n=deficit, temperature=temperature, generate_fn=generate_fn)\n        new_cands = sc[\"candidates\"]\n        new_tokens = sc[\"generated_tokens\"]\n\n    allc = existing + new_cands\n    return {\n        \"candidates\": allc,\n        \"answer\": compute_majority_vote([c.get(\"answer\") for c in allc]),\n        \"generation_calls\": len(new_cands),\n        \"total_samples\": len(allc),\n        \"generated_tokens\": new_tokens,\n        \"time_seconds\": time.perf_counter() - t0,\n    }","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-10T18:02:12.656203Z","iopub.execute_input":"2026-11-10T18:02:12.657148Z","iopub.status.idle":"2026-11-10T18:02:12.667276Z","shell.execute_reply.started":"2026-11-10T18:02:12.657114Z","shell.execute_reply":"2026-11-10T18:02:12.66648Z"}},"outputs":[{"name":"stdout","text":"Overwriting /kaggle/working/repo/src/search.py\n","output_type":"stream"}],"execution_count":24},{"cell_type":"markdown","source":"#### second smoke test ","metadata":{}},{"cell_type":"code","source":"!python tests/test_public_adapter_smoke.py","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026
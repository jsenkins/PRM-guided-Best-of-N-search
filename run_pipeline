ex).\n    Guarantees reproducibility and safe resumability after interruptions.\n    \"\"\"\n    try:\n        import transformers\n        transformers.set_seed(GLOBAL_SEED + problem_index)\n    except ImportError:\n        import random\n        random.seed(GLOBAL_SEED + problem_index)\n\n\ndef load_models(generator_device: str = \"cuda:0\", judge_device: str = \"cuda:1\"):\n    \"\"\"\n    Loads Qwen2.5-1.5B-Instruct in float16 (Generator) and\n    Qwen2.5-7B-Instruct in 4-bit NF4 (Judge).\n    \n    Hardware Mapping:\n      - Kaggle GPU T4x2: generator on cuda:0, judge on cuda:1.\n      - Single GPU: both models placed on cuda:0.\n      - Warning: Never use device_map=\"auto\" across two GPUs for a single model!\n    \"\"\"\n    import torch\n    from transformers import AutoModelForCausalLM, AutoTokenizer, BitsAndBytesConfig\n\n    num_gpus = torch.cuda.device_count() if torch.cuda.is_available() else 0\n    if num_gpus < 2:\n        g_dev = \"cuda:0\" if num_gpus == 1 else \"cpu\"\n        j_dev = \"cuda:0\" if num_gpus == 1 else \"cpu\"\n    else:\n        g_dev = generator_device\n        j_dev = judge_device\n\n    # 1. Generator: Qwen/Qwen2.5-1.5B-Instruct in float16 (~3.1 GB VRAM)\n    gen_id = \"Qwen/Qwen2.5-1.5B-Instruct\"\n    gen_tokenizer = AutoTokenizer.from_pretrained(gen_id)\n    if gen_tokenizer.pad_token_id is None:\n        gen_tokenizer.pad_token_id = gen_tokenizer.eos_token_id\n\n    gen_device_map = {\"\": g_dev} if g_dev != \"cpu\" else None\n    gen_model = AutoModelForCausalLM.from_pretrained(\n        gen_id,\n        torch_dtype=torch.float16 if g_dev != \"cpu\" else torch.float32,\n        device_map=gen_device_map,\n    )\n    if g_dev == \"cpu\":\n        gen_model = gen_model.to(\"cpu\")\n\n    # 2. Judge: Qwen/Qwen2.5-7B-Instruct in 4-bit NF4 (~5.5 GB VRAM)\n    judge_id = \"Qwen/Qwen2.5-7B-Instruct\"\n    judge_tokenizer = AutoTokenizer.from_pretrained(judge_id)\n    if judge_tokenizer.pad_token_id is None:\n        judge_tokenizer.pad_token_id = judge_tokenizer.eos_token_id\n\n    bnb_config = BitsAndBytesConfig(\n        load_in_4bit=True,\n        bnb_4bit_quant_type=\"nf4\",\n        bnb_4bit_compute_dtype=torch.float16,\n        bnb_4bit_use_double_quant=True,\n    )\n    judge_device_map = {\"\": j_dev} if j_dev != \"cpu\" else None\n    judge_model = AutoModelForCausalLM.from_pretrained(\n        judge_id,\n        quantization_config=bnb_config if j_dev != \"cpu\" else None,\n        torch_dtype=torch.float16 if j_dev != \"cpu\" else torch.float32,\n        device_map=judge_device_map,\n    )\n    if j_dev == \"cpu\":\n        judge_model = judge_model.to(\"cpu\")\n\n    return gen_model, gen_tokenizer, judge_model, judge_tokenizer\n\n\ndef _get_eos_token_ids(model: Any, tokenizer: Any) -> set[int]:\n    \"\"\"Extracts all EOS token IDs from model.generation_config and tokenizer.\"\"\"\n    eos_ids: set[int] = set()\n    if hasattr(model, \"generation_config\") and model.generation_config is not None:\n        cfg_eos = getattr(model.generation_config, \"eos_token_id\", None)\n        if cfg_eos is not None:\n            if isinstance(cfg_eos, int):\n                eos_ids.add(cfg_eos)\n            elif isinstance(cfg_eos, (list, tuple, set)):\n                eos_ids.update(cfg_eos)\n    if tokenizer is not None:\n        tok_eos = getattr(tokenizer, \"eos_token_id\", None)\n        if tok_eos is not None:\n            if isinstance(tok_eos, int):\n                eos_ids.add(tok_eos)\n            elif isinstance(tok_eos, (list, tuple, set)):\n                eos_ids.update(tok_eos)\n    return eos_ids\n\n\ndef _slice_to_first_eos(gen_tokens: Any, eos_ids: set[int]) -> Any:\n    \"\"\"Slices token sequence up to and including the first EOS token.\"\"\"\n    if hasattr(gen_tokens, \"tolist\"):\n        ids = gen_tokens.tolist()\n    else:\n        ids = list(gen_tokens)\n    first_eos_idx = None\n    for idx, tok in enumerate(ids):\n        if tok in eos_ids:\n            first_eos_idx = idx\n            break\n    if first_eos_idx is not None:\n        return gen_tokens[:first_eos_idx + 1]\n    return gen_tokens\n\n\ndef make_hf_generate_fn(model: Any, tokenizer: Any) -> Callable[[str, int, dict], list[dict]]:\n    \"\"\"\n    Factory creating a GenerateFn conforming to submission_adapter contract.\n    Applies the Qwen chat template to raw instruction prompts.\n    \"\"\"\n    def generate_fn(prompt: str, num_samples: int, gen_kwargs: dict) -> list[dict]:\n        try:\n            import torch\n            no_grad_ctx = torch.no_grad\n        except ImportError:\n            class _NoGrad:\n                def __enter__(self): return self\n                def __exit__(self, *args): pass\n            no_grad_ctx = lambda: _NoGrad()\n\n        messages = [{\"role\": \"user\", \"content\": prompt}]\n        formatted_prompt = tokenizer.apply_chat_template(\n            messages, tokenize=False, add_generation_prompt=True\n        )\n        inputs = tokenizer(formatted_prompt, return_tensors=\"pt\")\n        inputs = {k: v.to(model.device) if hasattr(v, \"to\") else v for k, v in inputs.items()}\n        prompt_len = inputs[\"input_ids\"].shape[1]\n\n        kwargs = dict(gen_kwargs)\n        if not kwargs.get(\"do_sample\", False):\n            kwargs[\"temperature\"] = None\n            kwargs[\"top_p\"] = None\n            kwargs[\"top_k\"] = None\n\n        if num_samples > 1 and kwargs.get(\"do_sample\", True):\n            kwargs[\"num_return_sequences\"] = num_samples\n\n        kwargs.setdefault(\"pad_token_id\", tokenizer.eos_token_id)\n\n        with no_grad_ctx():\n            output_ids = model.generate(**inputs, **kwargs)\n\n        eos_ids = _get_eos_token_ids(model, tokenizer)\n        results = []\n        for i in range(output_ids.shape[0]):\n            gen_tokens = output_ids[i][prompt_len:]\n            gen_tokens_valid = _slice_to_first_eos(gen_tokens, eos_ids)\n            text = tokenizer.decode(gen_tokens_valid, skip_special_tokens=True)\n            results.append({\"text\": text, \"num_tokens\": len(gen_tokens_valid)})\n        return results\n\n    return generate_fn\n\n\ndef make_hf_judge_fn(judge_model: Any, judge_tokenizer: Any) -> Callable[[str], dict]:\n    \"\"\"\n    Factory creating a JudgeFn conforming to submission_adapter contract.\n    Applies the Qwen chat template to raw judge prompts.\n    \"\"\"\n    def judge_fn(judge_prompt: str) -> dict:\n        try:\n            import torch\n            no_grad_ctx = torch.no_grad\n        except ImportError:\n            class _NoGrad:\n                def __enter__(self): return self\n                def __exit__(self, *args): pass\n            no_grad_ctx = lambda: _NoGrad()\n\n        messages = [{\"role\": \"user\", \"content\": judge_prompt}]\n        formatted = judge_tokenizer.apply_chat_template(\n            messages, tokenize=False, add_generation_prompt=True\n        )\n        inputs = judge_tokenizer(formatted, return_tensors=\"pt\")\n        inputs = {k: v.to(judge_model.device) if hasattr(v, \"to\") else v for k, v in inputs.items()}\n        prompt_len = inputs[\"input_ids\"].shape[1]\n\n        kwargs = dict(JUDGE_GEN_KWARGS)\n        kwargs.setdefault(\"pad_token_id\", judge_tokenizer.eos_token_id)\n\n        with no_grad_ctx():\n            output_ids = judge_model.generate(**inputs, **kwargs)\n\n        eos_ids = _get_eos_token_ids(judge_model, judge_tokenizer)\n        gen_tokens = output_ids[0][prompt_len:]\n        gen_tokens_valid = _slice_to_first_eos(gen_tokens, eos_ids)\n        text = judge_tokenizer.decode(gen_tokens_valid, skip_special_tokens=True)\n        return {\"text\": text, \"num_tokens\": len(gen_tokens_valid)}\n\n    return judge_fn\n\n\ndef save_results_summary(results_list: list[dict[str, Any]], filepath: str = \"outputs/results_summary.json\") -> None:\n    \"\"\"\n    Saves results_summary.json conforming strictly to the assignment schema:\n    Keys: 'Method', 'Accuracy (%)', 'Generation Calls', 'Judge Calls', 'Total LLM Calls',\n          'Avg Gen Tokens / Problem', 'Avg Judge Tokens / Problem', 'Total Time (s)'\n    \"\"\"\n    os.makedirs(os.path.dirname(filepath), exist_ok=True)\n    with open(filepath, \"w\", encoding=\"utf-8\") as f:\n        json.dump(results_list, f, indent=2)\n\n\ndef save_aggregation_ablation(ablation_list: list[dict[str, Any]], filepath: str = \"outputs/aggregation_ablation.json\") -> None:\n    \"\"\"\n    Saves aggregation_ablation.json:\n    List of {'Strategy': str, 'Lambda': float | None, 'Accuracy (%)': float, 'Tie Rate (%)': float}\n    \"\"\"\n    os.makedirs(os.path.dirname(filepath), exist_ok=True)\n    with open(filepath, \"w\", encoding=\"utf-8\") as f:\n        json.dump(ablation_list, f, indent=2)\n\n\ndef save_sc_scaling_curve(curve_list: list[dict[str, Any]], filepath: str = \"outputs/sc_scaling_curve.json\") -> None:\n    \"\"\"\n    Saves sc_scaling_curve.json:\n    List of {'N': int, 'Accuracy (%)': float, 'Avg Gen Tokens / Problem': float}\n    \"\"\"\n    os.makedirs(os.path.dirname(filepath), exist_ok=True)\n    with open(filepath, \"w\", encoding=\"utf-8\") as f:\n        json.dump(curve_list, f, indent=2)\n\n","output_type":"stream"}],"execution_count":6},{"cell_type":"markdown","source":"# problem 1 step structured generation and baseline decoders","metadata":{}},{"cell_type":"code","source":"with open('/kaggle/working/repo/src/generation.py', 'r') as f:\n    print(f.read())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-11T07:27:37.408945Z","iopub.execute_input":"2026-11-11T07:27:37.409347Z","iopub.status.idle":"2026-11-11T07:27:37.414338Z","shell.execute_reply.started":"2026-11-11T07:27:37.409321Z","shell.execute_reply":"2026-11-11T07:27:37.413687Z"},"collapsed":true,"jupyter":{"outputs_hidden":true}},"outputs":[{"name":"stdout","text":"\"\"\"\nsrc/generation.py - Prompt formatting and baseline generation routines.\n\"\"\"\nfrom typing import Any, Callable\nfrom collections import Counter\nfrom .extraction import extract_answer, parse_steps\nimport time\nfrom .utils import (make_hf_generate_fn, GREEDY_GEN_KWARGS, SAMPLING_GEN_KWARGS)\nGenerateFn = Callable[[str, int, dict], list[dict]]\n# generate_fn(raw_prompt, num_samples, gen_kwargs) -> list of {\"text\": str, \"num_tokens\": int}\n# gen_kwargs carries do_sample/temperature/top_p/top_k/repetition_penalty/max_new_tokens\n\n\ndef format_step_prompt(question: str) -> str:\n    \n    \"\"\"\n    Formats the raw problem question into a prompt that instructs the \n    model to emit numbered steps ('Step 1: ...') and 'Final Answer: <int>'.\n    \n    Returns a raw instruction string (no chat template applied).\n    \"\"\"\n    # TODO: Build zero-shot prompt enforcing step-structured reasoning\n    prompt=(\n        \n        f\"Question: {question}\\n\\n\"\n       \n        \"Give me the solution to the math question. Show all the numbered steps short explanation and provide a final answer as an integer only.\\n\"\n       \n        \"Follow the Format below \\n\"\n        \n       \n        \"Step 1: one short plain sentence with one calculation written like 1 * 5 = 5.\\n\"\n        \"Step 2: next short sentence with one calculation.\\n\"\n        \"Step 3: Continue with the next step and state the current values\\n\"\n       \n        \"(continue, one step per line)\\n\"\n        \"Final Answer: <integer>\\n\\n\"\n\n        \"Do not deviate from the following rules:\"\n\n         \"Use plain text only. No markdown, no LaTeX, no \\\\[ \\\\], no \\\\boxed{}, no brackets.\\n\"\n    \n        \"no units in the final answer.\\n\"\n        \"Every line before the last starts with 'Step k:'. No concluding sentence.\\n\"\n        \n        \n        \"write nothing after the last line that is the Final Answer line\\n\"\n        \"The last line must be only be 'Final Answer: number' replace the number placeholder with the actual answer value only\"\n        \n\n        \n   \n\n\n       )\n    \n    return prompt\n\n    \n    \n\ndef compute_majority_vote(answers: list[int | None]) -> int | None:\n    \"\"\"\n    Given a list of extracted answers, returns the majority answer.\n    Ignores None values. Breaks ties deterministically in favor of the answer\n    that appeared earliest in the list.\n    \"\"\"\n    # TODO: Implement deterministic majority voting\n    votes = [a for a in answers if a is not None]\n    if not votes:\n        return None\n    counts = Counter(votes)\n    highest = max(counts.values())\n    for a in votes:                  \n        if counts[a] == highest:\n            return a\n    \n\ndef run_greedy(\n    model: Any = None, \n    tokenizer: Any = None, \n    question: str = \"\", \n    generate_fn: GenerateFn | None = None\n) -> dict[str, Any]:\n    \"\"\"\n    Executes greedy decoding for a single question.\n    Calls generate_fn with num_samples=1 and gen_kwargs containing do_sample=False,\n    temperature=None, top_p=None, top_k=None.\n    \n    Returns:\n      prompt, completion, steps, answer, generation_calls, generated_tokens, time_seconds\n    \"\"\"\n    # TODO: Implement greedy baseline decoding\n    if generate_fn is None:\n        generate_fn = make_hf_generate_fn(model, tokenizer)\n    gen_kwargs = dict(GREEDY_GEN_KWARGS)\n    prompt = format_step_prompt(question)\n    start = time.perf_counter()\n    out = generate_fn(prompt, 1, gen_kwargs)[0]\n    elapsed = time.perf_counter() - start\n    completion = out.get(\"text\", \"\")\n    return {\n        \"prompt\": prompt,\n        \"completion\": completion,\n        \"steps\": parse_steps(completion),\n        \"answer\": extract_answer(completion),\n        \"generation_calls\": 1,\n        \"generated_tokens\": int(out.get(\"num_tokens\", 0)),\n        \"time_seconds\": elapsed,\n    }\n\n\n\n\ndef run_self_consistency(\n    model: Any = None, \n    tokenizer: Any = None, \n    question: str = \"\", \n    n: int = 5, \n    temperature: float = 0.7, \n    generate_fn: GenerateFn | None = None\n) -> dict[str, Any]:\n    \"\"\"\n    Samples n diverse reasoning trajectories and aggregates candidate answers via majority vote.\n    \n    Returns:\n      candidates [each: completion, steps, answer, num_tokens], answer, \n      generation_calls, generated_tokens, time_seconds\n    \"\"\"\n    # TODO: Implement Self-Consistency sampling and majority voting\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n    if generate_fn is None:\n        generate_fn = make_hf_generate_fn(model, tokenizer)\n\n    prompt = format_step_prompt(question)\n    gen_kwargs = dict(SAMPLING_GEN_KWARGS)\n    gen_kwargs[\"temperature\"] = temperature\n\n    start = time.perf_counter()\n    outputs = generate_fn(prompt, n, gen_kwargs)\n    elapsed = time.perf_counter() - start\n\n    candidates = []\n    answers = []\n    generated_tokens = 0\n\n    for output in outputs:\n        completion = output.get(\"text\", \"\")\n        steps = parse_steps(completion)\n        answer = extract_answer(completion)\n        num_tokens = int(output.get(\"num_tokens\", 0))\n\n        candidates.append({\n            \"completion\": completion,\n            \"steps\": steps,\n            \"answer\": answer,\n            \"num_tokens\": num_tokens,\n        })\n        answers.append(answer)\n        generated_tokens += num_tokens\n\n    return {\n        \"candidates\": candidates,\n        \"answer\": compute_majority_vote(answers),   \n        \"generation_calls\": len(candidates),\n        \"generated_tokens\": generated_tokens,\n        \"time_seconds\": elapsed,\n    }\n\n","output_type":"stream"}],"execution_count":3},{"cell_type":"code","source":"with open('/kaggle/working/repo/submission_adapter.py', 'r') as f:\n    print(f.read())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-08T13:14:03.75589Z","iopub.execute_input":"2026-11-08T13:14:03.756661Z","iopub.status.idle":"2026-11-08T13:14:03.76187Z","shell.execute_reply.started":"2026-11-08T13:14:03.756628Z","shell.execute_reply":"2026-11-08T13:14:03.761145Z"},"collapsed":true,"jupyter":{"outputs_hidden":true}},"outputs":[{"name":"stdout","text":"\"\"\"\nCS 5326: Advanced Generative AI and Agents - Programming Assignment 3\nSubmission Adapter Interface Contract.\n\"\"\"\nfrom typing import Any, Callable\n\n# Type Aliases as mandated by the assignment contract\nGenerateFn = Callable[[str, int, dict], list[dict]]\n# generate_fn(raw_prompt, num_samples, gen_kwargs) -> list of {\"text\": str, \"num_tokens\": int}\n# gen_kwargs carries do_sample/temperature/top_p/top_k/repetition_penalty/max_new_tokens\n\nJudgeFn = Callable[[str], dict]\n# judge_fn(judge_prompt) -> {\"text\": str, \"num_tokens\": int}\n\ntry:\n    from .src.extraction import extract_answer as _extract_answer\n    from .src.extraction import parse_steps as _parse_steps\n    from .src.generation import compute_majority_vote as _compute_majority_vote\n    from .src.generation import format_step_prompt as _format_step_prompt\n    from .src.generation import run_greedy as _run_greedy\n    from .src.generation import run_self_consistency as _run_self_consistency\n    from .src.prm_judge import build_prm_judge_prompt as _build_prm_judge_prompt\n    from .src.prm_judge import parse_judge_decision as _parse_judge_decision\n    from .src.prm_judge import score_path as _score_path\n    from .src.search import aggregate_path_score as _aggregate_path_score\n    from .src.search import run_compute_matched_self_consistency as _run_compute_matched_self_consistency\n    from .src.search import run_prm_best_of_n as _run_prm_best_of_n\n    from .src.search import select_best_path as _select_best_path\nexcept ImportError:\n    from src.extraction import extract_answer as _extract_answer\n    from src.extraction import parse_steps as _parse_steps\n    from src.generation import compute_majority_vote as _compute_majority_vote\n    from src.generation import format_step_prompt as _format_step_prompt\n    from src.generation import run_greedy as _run_greedy\n    from src.generation import run_self_consistency as _run_self_consistency\n    from src.prm_judge import build_prm_judge_prompt as _build_prm_judge_prompt\n    from src.prm_judge import parse_judge_decision as _parse_judge_decision\n    from src.prm_judge import score_path as _score_path\n    from src.search import aggregate_path_score as _aggregate_path_score\n    from src.search import run_compute_matched_self_consistency as _run_compute_matched_self_consistency\n    from src.search import run_prm_best_of_n as _run_prm_best_of_n\n    from src.search import select_best_path as _select_best_path\n\n\ndef format_step_prompt(question: str) -> str:\n    \"\"\"Formats the raw problem question into a prompt that instructs the \n    model to emit numbered steps ('Step 1: ...') and 'Final Answer: <int>'.\n    \n    Returns a raw instruction string (no chat template applied).\n    \n    Args:\n        question: The raw text of the grade school math question.\n        \n    Returns:\n        The formatted prompt string to feed to the language model.\n    \"\"\"\n    return _format_step_prompt(question)\n\n\ndef parse_steps(completion_text: str) -> list[str]:\n    \"\"\"Parses completion text and returns a list of individual step strings.\n    \n    Must tolerate markdown decoration around labels (e.g. '**Step 1:**', '### Step 2:')\n    and strip leftover '*' or '#' from captured text.\n    \n    Args:\n        completion_text: The raw output text generated by the model.\n        \n    Returns:\n        A list of clean step strings, e.g. [\"Janet starts with 16 eggs.\", ...].\n    \"\"\"\n    return _parse_steps(completion_text)\n\n\ndef extract_answer(completion_text: str) -> int | None:\n    \"\"\"Extracts the final numeric integer from the completion.\n    \n    Required Behaviors:\n      - 'Final Answer: 18' -> 18\n      - 'Final Answer: $1,234' -> 1234\n      - 'Final Answer: 18.00' -> 18\n      - 'Final Answer: 18.5' -> None (non-integer)\n      - 'Final Answer: -5' -> -5\n      - 'Final Answer: 18 dollars.' -> 18\n      - '**Final Answer:** 18' -> 18\n      - 'final answer 18' (case-insensitive, colon optional) -> 18\n      - Multiple 'Final Answer' lines -> use the LAST one\n      - No 'Final Answer' present -> None\n      - Empty string or None-like garbage -> None, and never raise\n      \n    Args:\n        completion_text: The raw output text generated by the model.\n        \n    Returns:\n        The extracted integer, or None if extraction fails.\n    \"\"\"\n    return _extract_answer(completion_text)\n\n\ndef compute_majority_vote(answers: list[int | None]) -> int | None:\n    \"\"\"Given a list of extracted answers, returns the majority answer.\n    \n    - Ignores None values.\n    - If all values are None or list is empty, returns None.\n    - In case of a tie between candidate answers, breaks ties deterministically \n      in favor of the answer that appeared earliest in the list.\n      \n    Args:\n        answers: A list of candidate answers (integers or None).\n        \n    Returns:\n        The majority voted integer, or None.\n    \"\"\"\n    return _compute_majority_vote(answers)\n\n\ndef build_prm_judge_prompt(question: str, preceding_steps: list[str], current_step: str) -> str:\n    \"\"\"Builds the verification prompt for the PRM judge to classify current_step \n    as VALID or INVALID given the problem question and preceding_steps.\n    \n    Judge Semantics (Local Validity):\n      The judge evaluates current_step ASSUMING ALL PRECEDING STEPS ARE CORRECT.\n      A step is VALID if its arithmetic is sound and it follows logically from the\n      problem statement plus preceding steps as written. An error in an earlier step\n      does NOT make subsequent steps invalid by itself.\n      \n    Autograder Literal Checks:\n      - Preceding steps are rendered as 'Step 1: <text>', 'Step 2: <text>', ... in order.\n      - The current step is rendered with the label 'Current Step:'.\n      - The prompt contains the phrase 'assume all preceding steps are correct' (case-insensitive).\n      - The prompt contains the literal strings 'Verdict: VALID', 'Verdict: INVALID', and 'Rationale:'.\n      - With an empty preceding_steps list, the prompt states '(no preceding steps)'.\n      \n    Args:\n        question: The original problem statement.\n        preceding_steps: List of steps that precede the current step.\n        current_step: The specific candidate step to be scrutinized.\n        \n    Returns:\n        The formatted judge prompt string.\n    \"\"\"\n    return _build_prm_judge_prompt(question, preceding_steps, current_step)\n\n\ndef parse_judge_decision(judge_output: str) -> tuple[float, str]:\n    \"\"\"Parses the judge model's raw text completion into (score, rationale).\n    \n    Rationale: Text after 'Rationale:' up to first sentence end ('.', '!', '?' followed\n    by whitespace or end of string, so decimals like '2.5' are not split) or newline,\n    whichever comes first, stripped. If absent, returns empty string \"\".\n    \"\"\"\n    return _parse_judge_decision(judge_output)\n\n\ndef aggregate_path_score(\n    step_scores: list[float], \n    strategy: str = \"min\", \n    penalty_lambda: float = 2.0\n) -> float:\n    \"\"\"Aggregates a list of step scores into a single path scalar score.\n    \n    Rules:\n      - An empty list returns -1.0 for every strategy.\n      - 'min': min(step_scores).\n      - 'product': p_t = clamp((r_t + 1)/2, 0.01, 0.99); returns the raw product.\n      - 'step_penalty': mean(step_scores) - penalty_lambda * count(r_t == -1.0).\n      - An unknown strategy raises ValueError.\n        \n    Args:\n        step_scores: List of float scores for each step in the path (+1.0 or -1.0).\n        strategy: Aggregation strategy name ('min', 'product', or 'step_penalty').\n        penalty_lambda: Penalty weight for erroneous steps in 'step_penalty' (default 2.0).\n        \n    Returns:\n        Aggregated scalar score as a float.\n    \"\"\"\n    return _aggregate_path_score(step_scores, strategy=strategy, penalty_lambda=penalty_lambda)\n\n\ndef select_best_path(\n    candidate_paths: list[dict[str, Any]], \n    aggregation_strategy: str = \"min\", \n    penalty_lambda: float = 2.0\n) -> dict[str, Any]:\n    \"\"\"Given a list of candidate dictionaries containing 'steps', 'step_scores', \n    and 'answer', computes the aggregated path score for each candidate and \n    returns the highest-scoring candidate dictionary.\n    \n    Input Dictionary Contract:\n      Each candidate dictionary in candidate_paths must contain 'step_scores' (list[float])\n      and 'answer' (int | None). Any other keys present in the candidate dictionary\n      are passed through unchanged in the returned copy.\n    \n    Selection & Tie-Breaking Rules:\n      1. Compute path_score for each candidate with aggregate_path_score.\n         A candidate with an empty step_scores list gets -1.0.\n      2. Eligibility: if at least one candidate has a non-None answer, candidates\n         with answer=None are excluded. If all answers are None, all remain eligible.\n      3. Find maximum path_score among eligible candidates (tolerance 1e-9).\n         The tied set is all eligible candidates within tolerance of the maximum.\n      4. If the tied set has more than one candidate, compute compute_majority_vote\n         over their answers. Return the lowest-index candidate in the tied set whose\n         answer equals the vote. If the vote is None, return the lowest-index tied candidate.\n      5. Returns a shallow COPY of the chosen dict with two added keys:\n         'path_score' (float) and 'num_tied' (int, size of the tied set).\n         Does not mutate the inputs.\n        \n    Args:\n        candidate_paths: List of dicts, each with keys 'steps', 'step_scores', and 'answer'.\n        aggregation_strategy: The aggregation strategy string to use.\n        penalty_lambda: Penalty weight for step_penalty aggregation.\n        \n    Returns:\n        The winning candidate dict copy with added keys 'path_score' and 'num_tied'.\n    \"\"\"\n    return _select_best_path(candidate_paths, aggregation_strategy=aggregation_strategy, penalty_lambda=penalty_lambda)\n\n\ndef run_greedy(\n    model: Any = None, \n    tokenizer: Any = None, \n    question: str = \"\", \n    generate_fn: GenerateFn | None = None\n) -> dict[str, Any]:\n    \"\"\"Executes deterministic greedy decoding for a question.\n    \n    Must call generate_fn with num_samples=1 and gen_kwargs containing do_sample=False,\n    temperature=None, top_p=None, top_k=None.\n    \n    Returns:\n        Dict with keys:\n          'prompt': formatted prompt string,\n          'completion': raw output text,\n          'steps': parsed list of steps,\n          'answer': extracted final answer int or None,\n          'generation_calls': 1,\n          'generated_tokens': total tokens produced,\n          'time_seconds': float elapsed time\n    \"\"\"\n    return _run_greedy(model=model, tokenizer=tokenizer, question=question, generate_fn=generate_fn)\n\n\ndef run_self_consistency(\n    model: Any = None, \n    tokenizer: Any = None, \n    question: str = \"\", \n    n: int = 5, \n    temperature: float = 0.7, \n    generate_fn: GenerateFn | None = None\n) -> dict[str, Any]:\n    \"\"\"Samples n diverse reasoning trajectories and aggregates candidate answers via majority vote.\n    \n    Returns:\n        Dict with keys:\n          'candidates': list of dicts with 'completion', 'steps', 'answer', 'num_tokens',\n          'answer': majority voted answer int or None,\n          'generation_calls': n,\n          'generated_tokens': total tokens produced across all candidates,\n          'time_seconds': float elapsed time\n    \"\"\"\n    return _run_self_consistency(\n        model=model, tokenizer=tokenizer, question=question, n=n, \n        temperature=temperature, generate_fn=generate_fn\n    )\n\n\ndef score_path(\n    judge_model: Any = None, \n    judge_tokenizer: Any = None, \n    question: str = \"\", \n    candidate: dict[str, Any] | None = None, \n    judge_fn: JudgeFn | None = None\n) -> dict[str, Any]:\n    \"\"\"Sequentially scores each step in candidate[\"steps\"] using judge_fn.\n    Step t is judged with preceding_steps = steps[:t].\n    \n    The student's code MUST call build_prm_judge_prompt to build the string passed to judge_fn,\n    and MUST call parse_judge_decision on the returned text.\n    \n    Returns:\n        Dict with keys:\n          'step_scores': list of float scores (+1.0 or -1.0),\n          'rationales': list of str rationales,\n          'judge_calls': int (=len(steps)),\n          'judge_tokens': int (total tokens returned by judge)\n    \"\"\"\n    return _score_path(\n        judge_model=judge_model, judge_tokenizer=judge_tokenizer, \n        question=question, candidate=candidate, judge_fn=judge_fn\n    )\n\n\ndef run_prm_best_of_n(\n    model: Any = None, \n    judge_model: Any = None, \n    gen_tokenizer: Any = None, \n    judge_tokenizer: Any = None, \n    question: str = \"\", \n    n: int = 5, \n    aggregation_strategy: str = \"min\", \n    penalty_lambda: float = 2.0, \n    candidates: list[dict[str, Any]] | None = None, \n    generate_fn: GenerateFn | None = None, \n    judge_fn: JudgeFn | None = None\n) -> dict[str, Any]:\n    \"\"\"Executes PRM-guided Best-of-N search over candidate trajectories.\n    \n    If candidates is provided (shared candidate pool), does NOT sample new paths\n    (generation_calls = 0, generated_tokens = 0).\n    Provided candidates use the run_self_consistency candidate format (at minimum 'steps' and 'answer').\n    Otherwise, samples n candidates.\n    Every candidate has all steps scored by judge_fn (no early stopping).\n    Selects the winning candidate via select_best_path.\n    \n    Returns:\n        Dict with keys:\n          'selected': winning candidate dict from select_best_path,\n          'answer': winning candidate answer,\n          'candidates': list of candidates augmented with 'step_scores' and 'rationales',\n          'generation_calls': int (new samples drawn inside this call; 0 if candidates provided),\n          'judge_calls': int (total step evaluations),\n          'generated_tokens': int (new samples only),\n          'judge_tokens': int (total judge output tokens),\n          'time_seconds': float elapsed time\n    \"\"\"\n    return _run_prm_best_of_n(\n        model=model, judge_model=judge_model, \n        gen_tokenizer=gen_tokenizer, judge_tokenizer=judge_tokenizer, \n        question=question, n=n, \n        aggregation_strategy=aggregation_strategy, \n        penalty_lambda=penalty_lambda, \n        candidates=candidates, \n        generate_fn=generate_fn, \n        judge_fn=judge_fn\n    )\n\n\ndef run_compute_matched_self_consistency(\n    model: Any = None, \n    tokenizer: Any = None, \n    question: str = \"\", \n    target_calls: int = 15, \n    temperature: float = 0.7, \n    existing_candidates: list[dict[str, Any]] | None = None, \n    generate_fn: GenerateFn | None = None\n) -> dict[str, Any]:\n    \"\"\"Executes compute-matched Self-Consistency aggregating target_calls paths.\n    \n    If existing_candidates is provided, samples only target_calls - len(existing_candidates).\n    Votes over all candidates combined.\n    Returned candidates = existing_candidates followed by new samples, in sampling order.\n    \n    Returns:\n        Dict with keys:\n          'candidates': list of all target_calls candidate dicts (existing_candidates\n                        followed by new samples, in sampling order),\n          'answer': majority vote over all candidate answers,\n          'generation_calls': int (new samples drawn only),\n          'total_samples': int (=target_calls),\n          'generated_tokens': int (new samples only),\n          'time_seconds': float elapsed time\n    \"\"\"\n    return _run_compute_matched_self_consistency(\n        model=model, tokenizer=tokenizer, question=question, \n        target_calls=target_calls, temperature=temperature, \n        existing_candidates=existing_candidates, \n        generate_fn=generate_fn\n    )\n\n","output_type":"stream"}],"execution_count":3},{"cell_type":"code","source":"%%writefile /kaggle/working/repo/src/extraction.py\n\"\"\"\nsrc/extraction.py - Step and answer extraction utilities.\n\"\"\"\nimport re\n\n\ndef parse_steps(completion_text: str) -> list[str]:\n    \"\"\"\n    Parses completion text and returns a list of individual step strings.\n    Must tolerate markdown decoration around labels (e.g. '**Step 1:**', '### Step 2:')\n    and strip leftover '*' or '#' from captured text.\n    \"\"\"\n    if not completion_text or not isinstance(completion_text, str):\n        return []\n\n    # Pattern matching Step markers with optional markdown decoration (#, *, `, :, .)\n    pattern = r\"(?:^|\\n)\\s*(?:[#*`\\s]*Step\\s*\\d+\\s*[:.]?[#*`\\s]*)(.*?)(?=(?:\\n\\s*[#*`\\s]*Step\\s*\\d+\\s*[:.]?[#*`\\s]*)|(?:\\n\\s*[#*`\\s]*Final Answer)|$)\"\n    matches = re.findall(pattern, completion_text, flags=re.DOTALL | re.IGNORECASE)\n    cleaned = []\n    for m in matches:\n        text = m.strip().strip(\"*#`\").strip()\n        if text:\n            cleaned.append(text)\n    return cleaned\n\n\ndef extract_answer(completion_text: str) -> int | None:\n    \"\"\"\n    Extracts the final numeric integer from the completion.\n\n    Required Behaviors:\n      - 'Final Answer: 18' -> 18\n      - 'Final Answer: $1,234' -> 1234\n      - 'Final Answer: 18.00' -> 18\n      - 'Final Answer: 18.5' -> None (non-integer)\n      - 'Final Answer: -5' -> -5\n      - 'Final Answer: 18 dollars.' -> 18\n      - '**Final Answer:** 18' -> 18\n      - 'final answer 18' (case-insensitive, colon optional) -> 18\n      - Multiple 'Final Answer' lines -> use the LAST one\n      - No 'Final Answer' present -> None\n      - Empty string or None-like garbage -> None, and never raise\n    \"\"\"\n    # TODO: Implement robust regex answer extraction\n        \n    \n    try:\n        \n        if not completion_text or not isinstance(completion_text, str):\n            return None\n\n        delimiters = list(re.finditer(r\"final[ \\t]*answer\", completion_text, flags=re.IGNORECASE))\n        if not delimiters:\n            return None\n        line = completion_text[delimiters[-1].end():].split(\"\\n\", 1)[0]\n\n        #used claude to help with the following part \n\n        pattern = (\n            r\"(?:\\s*is\\b)?[\\s:=*]*\"\n            r\"\\$?\\s*(?P<sign>[-\\u2212])?\\s*\\$?\\s*\"\n            r\"(?P<int>\\d{1,3}(?:,\\d{3})+|\\d+)\"\n            r\"(?:\\.(?P<frac>\\d+))?\"\n            )\n        m = re.match(pattern, line, flags=re.IGNORECASE)\n        if not m:\n            return None\n        if m.group(\"frac\") and m.group(\"frac\").strip(\"0\"):\n            return None\n\n        val = int(m.group(\"int\").replace(\",\", \"\"))\n        return -val if m.group(\"sign\") else val\n    \n    except Exception:\n        return None\n\n      \n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-10T17:42:15.914311Z","iopub.execute_input":"2026-11-10T17:42:15.915191Z","iopub.status.idle":"2026-11-10T17:42:15.922687Z","shell.execute_reply.started":"2026-11-10T17:42:15.915155Z","shell.execute_reply":"2026-11-10T17:42:15.921944Z"}},"outputs":[{"name":"stdout","text":"Overwriting /kaggle/working/repo/src/extraction.py\n","output_type":"stream"}],"execution_count":5},{"cell_type":"code","source":"%%writefile /kaggle/working/repo/src/generation.py\n\"\"\"\nsrc/generation.py - Prompt formatting and baseline generation routines.\n\"\"\"\nfrom typing import Any, Callable\nfrom collections import Counter\nfrom .extraction import extract_answer, parse_steps\nimport time\nfrom .utils import (make_hf_generate_fn, GREEDY_GEN_KWARGS, SAMPLING_GEN_KWARGS)\nGenerateFn = Callable[[str, int, dict], list[dict]]\n# generate_fn(raw_prompt, num_samples, gen_kwargs) -> list of {\"text\": str, \"num_tokens\": int}\n# gen_kwargs carries do_sample/temperature/top_p/top_k/repetition_penalty/max_new_tokens\n\n\ndef format_step_prompt(question: str) -> str:\n    \n    \"\"\"\n    Formats the raw problem question into a prompt that instructs the \n    model to emit numbered steps ('Step 1: ...') and 'Final Answer: <int>'.\n    \n    Returns a raw instruction string (no chat template applied).\n    \"\"\"\n    # TODO: Build zero-shot prompt enforcing step-structured reasoning\n    prompt=(\n        \n        f\"Question: {question}\\n\\n\"\n       \n        \"Give me the solution to the math question. Show all the numbered steps short explanation and provide a final answer as an integer only.\\n\"\n       \n        \"Follow the Format below \\n\"\n        \n       \n        \"Step 1: one short plain sentence with one calculation written like 1 * 5 = 5.\\n\"\n        \"Step 2: next short sentence with one calculation.\\n\"\n        \"Step 3: Continue with the next step and state the current values\\n\"\n       \n        \"(continue, one step per line)\\n\"\n        \"Final Answer: <integer>\\n\\n\"\n\n        \"Do not deviate from the following rules:\"\n\n         \"Use plain text only. No markdown, no LaTeX, no \\\\[ \\\\], no \\\\boxed{}, no brackets.\\n\"\n    \n        \"no units in the final answer.\\n\"\n        \"Every line before the last starts with 'Step k:'. No concluding sentence.\\n\"\n        \n        \n        \"write nothing after the last line that is the Final Answer line\\n\"\n        \"The last line must be only be 'Final Answer: number' replace the number placeholder with the actual answer value only\"\n        \n\n        \n   \n\n\n       )\n    \n    return prompt\n\n    \n    \n\ndef compute_majority_vote(answers: list[int | None]) -> int | None:\n    \"\"\"\n    Given a list of extracted answers, returns the majority answer.\n    Ignores None values. Breaks ties deterministically in favor of the answer\n    that appeared earliest in the list.\n    \"\"\"\n    # TODO: Implement deterministic majority voting\n    votes = [a for a in answers if a is not None]\n    if not votes:\n        return None\n    counts = Counter(votes)\n    highest = max(counts.values())\n    for a in votes:                  \n        if counts[a] == highest:\n            return a\n    \n\ndef run_greedy(\n    model: Any = None, \n    tokenizer: Any = None, \n    question: str = \"\", \n    generate_fn: GenerateFn | None = None\n) -> dict[str, Any]:\n    \"\"\"\n    Executes greedy decoding for a single question.\n    Calls generate_fn with num_samples=1 and gen_kwargs containing do_sample=False,\n    temperature=None, top_p=None, top_k=None.\n    \n    Returns:\n      prompt, completion, steps, answer, generation_calls, generated_tokens, time_seconds\n    \"\"\"\n    # TODO: Implement greedy baseline decoding\n    if generate_fn is None:\n        generate_fn = make_hf_generate_fn(model, tokenizer)\n    gen_kwargs = dict(GREEDY_GEN_KWARGS)\n    prompt = format_step_prompt(question)\n    start = time.perf_counter()\n    out = generate_fn(prompt, 1, gen_kwargs)[0]\n    elapsed = time.perf_counter() - start\n    completion = out.get(\"text\", \"\")\n    return {\n        \"prompt\": prompt,\n        \"completion\": completion,\n        \"steps\": parse_steps(completion),\n        \"answer\": extract_answer(completion),\n        \"generation_calls\": 1,\n        \"generated_tokens\": int(out.get(\"num_tokens\", 0)),\n        \"time_seconds\": elapsed,\n    }\n\n\n\n\ndef run_self_consistency(\n    model: Any = None, \n    tokenizer: Any = None, \n    question: str = \"\", \n    n: int = 5, \n    temperature: float = 0.7, \n    generate_fn: GenerateFn | None = None\n) -> dict[str, Any]:\n    \"\"\"\n    Samples n diverse reasoning trajectories and aggregates candidate answers via majority vote.\n    \n    Returns:\n      candidates [each: completion, steps, answer, num_tokens], answer, \n      generation_calls, generated_tokens, time_seconds\n    \"\"\"\n    # TODO: Implement Self-Consistency sampling and majority voting\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n    if generate_fn is None:\n        generate_fn = make_hf_generate_fn(model, tokenizer)\n\n    prompt = format_step_prompt(question)\n    gen_kwargs = dict(SAMPLING_GEN_KWARGS)\n    gen_kwargs[\"temperature\"] = temperature\n\n    start = time.perf_counter()\n    outputs = generate_fn(prompt, n, gen_kwargs)\n    elapsed = time.perf_counter() - start\n\n    candidates = []\n    answers = []\n    generated_tokens = 0\n\n    for output in outputs:\n        completion = output.get(\"text\", \"\")\n        steps = parse_steps(completion)\n        answer = extract_answer(completion)\n        num_tokens = int(output.get(\"num_tokens\", 0))\n\n        candidates.append({\n            \"completion\": completion,\n            \"steps\": steps,\n            \"answer\": answer,\n            \"num_tokens\": num_tokens,\n        })\n        answers.append(answer)\n        generated_tokens += num_tokens\n\n    return {\n        \"candidates\": candidates,\n        \"answer\": compute_majority_vote(answers),   \n        \"generation_calls\": len(candidates),\n        \"generated_tokens\": generated_tokens,\n        \"time_seconds\": elapsed,\n    }","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-10T17:42:37.521066Z","iopub.execute_input":"2026-11-10T17:42:37.521576Z","iopub.status.idle":"2026-11-10T17:42:37.529761Z","shell.execute_reply.started":"2026-11-10T17:42:37.521547Z","shell.execute_reply":"2026-11-10T17:42:37.528948Z"}},"outputs":[{"name":"stdout","text":"Overwriting /kaggle/working/repo/src/generation.py\n","output_type":"stream"}],"execution_count":6},{"cell_type":"code","source":"\n\"\"\"\nsrc/utils.py - Model loading, generation constants, seed management, and factories.\n\"\"\"\nimport json\nimport os\nfrom typing import Any, Callable\n\n# Global random seed specified by course policy\nGLOBAL_SEED = 5326\n\n# Sampling & decoding hyperparameter configurations\nGREEDY_GEN_KWARGS = {\n    \"do_sample\": False,\n    \"temperature\": None,\n    \"top_p\": None,\n    \"top_k\": None,\n    \"max_new_tokens\": 512,\n}\n\nSAMPLING_GEN_KWARGS = {\n    \"do_sample\": True,\n    \"temperature\": 0.7,\n    \"top_p\": 1.0,\n    \"top_k\": 0,\n    \"repetition_penalty\": 1.0,\n    \"max_new_tokens\": 512,\n}\n\nJUDGE_GEN_KWARGS = {\n    \"do_sample\": False,\n    \"temperature\": None,\n    \"top_p\": None,\n    \"top_k\": None,\n    \"max_new_tokens\": 96,\n}\n\n\ndef set_seed_for_problem(problem_index: int) -> None:\n    \"\"\"\n    Sets a deterministic seed for problem_index (5326 + problem_index).\n    Guarantees reproducibility and safe resumability after interruptions.\n    \"\"\"\n    try:\n        import transformers\n        transformers.set_seed(GLOBAL_SEED + problem_index)\n    except ImportError:\n        import random\n        random.seed(GLOBAL_SEED + problem_index)\n\n\ndef load_models(generator_device: str = \"cuda:0\", judge_device: str = \"cuda:1\"):\n    \"\"\"\n    Loads Qwen2.5-1.5B-Instruct in float16 (Generator) and\n    Qwen2.5-7B-Instruct in 4-bit NF4 (Judge).\n    \n    Hardware Mapping:\n      - Kaggle GPU T4x2: generator on cuda:0, judge on cuda:1.\n      - Single GPU: both models placed on cuda:0.\n      - Warning: Never use device_map=\"auto\" across two GPUs for a single model!\n    \"\"\"\n    import torch\n    from transformers import AutoModelForCausalLM, AutoTokenizer, BitsAndBytesConfig\n\n    num_gpus = torch.cuda.device_count() if torch.cuda.is_available() else 0\n    if num_gpus < 2:\n        g_dev = \"cuda:0\" if num_gpus == 1 else \"cpu\"\n        j_dev = \"cuda:0\" if num_gpus == 1 else \"cpu\"\n    else:\n        g_dev = generator_device\n        j_dev = judge_device\n\n    # 1. Generator: Qwen/Qwen2.5-1.5B-Instruct in float16 (~3.1 GB VRAM)\n    gen_id = \"Qwen/Qwen2.5-1.5B-Instruct\"\n    gen_tokenizer = AutoTokenizer.from_pretrained(gen_id)\n    if gen_tokenizer.pad_token_id is None:\n        gen_tokenizer.pad_token_id = gen_tokenizer.eos_token_id\n\n    gen_device_map = {\"\": g_dev} if g_dev != \"cpu\" else None\n    gen_model = AutoModelForCausalLM.from_pretrained(\n        gen_id,\n        torch_dtype=torch.float16 if g_dev != \"cpu\" else torch.float32,\n        device_map=gen_device_map,\n    )\n    if g_dev == \"cpu\":\n        gen_model = gen_model.to(\"cpu\")\n\n    # 2. Judge: Qwen/Qwen2.5-7B-Instruct in 4-bit NF4 (~5.5 GB VRAM)\n    judge_id = \"Qwen/Qwen2.5-7B-Instruct\"\n    judge_tokenizer = AutoTokenizer.from_pretrained(judge_id)\n    if judge_tokenizer.pad_token_id is None:\n        judge_tokenizer.pad_token_id = judge_tokenizer.eos_token_id\n\n    bnb_config = BitsAndBytesConfig(\n        load_in_4bit=True,\n        bnb_4bit_quant_type=\"nf4\",\n        bnb_4bit_compute_dtype=torch.float16,\n        bnb_4bit_use_double_quant=True,\n    )\n    judge_device_map = {\"\": j_dev} if j_dev != \"cpu\" else None\n    judge_model = AutoModelForCausalLM.from_pretrained(\n        judge_id,\n        quantization_config=bnb_config if j_dev != \"cpu\" else None,\n        torch_dtype=torch.float16 if j_dev != \"cpu\" else torch.float32,\n        device_map=judge_device_map,\n    )\n    if j_dev == \"cpu\":\n        judge_model = judge_model.to(\"cpu\")\n\n    return gen_model, gen_tokenizer, judge_model, judge_tokenizer\n\n\ndef _get_eos_token_ids(model: Any, tokenizer: Any) -> set[int]:\n    \"\"\"Extracts all EOS token IDs from model.generation_config and tokenizer.\"\"\"\n    eos_ids: set[int] = set()\n    if hasattr(model, \"generation_config\") and model.generation_config is not None:\n        cfg_eos = getattr(model.generation_config, \"eos_token_id\", None)\n        if cfg_eos is not None:\n            if isinstance(cfg_eos, int):\n                eos_ids.add(cfg_eos)\n         